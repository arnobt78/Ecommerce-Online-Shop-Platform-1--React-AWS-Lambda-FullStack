# CodeBook Frontend Environment Variables
# Copy this file to .env and update the values
# Parent: REQ-1300 — renamed REACT_APP_* -> VITE_* for the Vite migration (CRA is gone).

# Backend API base URL (Express + PostgreSQL backend — see backend/, REQ-1200)
# Local: Vite frontend is :3000; put the API on :4000 to avoid a port clash
# (set PORT=4000 in backend/.env). Production: Coolify URL once deployed (REQ-1210/1211).
VITE_LAMBDA_API_URL=http://localhost:4000

# Note: the Login page's demo-account quick-login list (REQ-1510) is served by
# the backend (GET /auth/demo-accounts, driven by the User.isDemo column) —
# no VITE_GUEST_LOGIN/VITE_ADMIN_LOGIN vars needed here anymore.

# Public site origin, used for absolute links (order QR codes, share URLs).
# Optional — falls back to window.location.origin, so only needed in
# server-rendered/build-time contexts where that isn't available.
# Public site origin (frontend). Optional — falls back to window.location.origin.
VITE_BASE_URL=http://localhost:3000

# Stripe publishable key (safe to expose in the frontend bundle).
VITE_STRIPE_PUB_KEY=

# Cloudinary image hosting (optional — services/imageService.ts falls back to
# the shared demo Cloudinary account if unset, so these are only needed to
# point uploads at your own Cloudinary account).
VITE_IMAGE_SERVICE=cloudinary
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Sentry (error monitoring) — https://sentry.io. DSNs are designed to be
# public (safe in a frontend bundle, unlike an auth token). Requests are
# tunneled through the backend's POST /api/monitoring (see backend/.env.example
# SENTRY_* vars) so ad-blockers can't silently drop error reports.
VITE_SENTRY_DSN=
