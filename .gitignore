# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Note: Root .gitignore handles most patterns. This file is for codebook-specific ignores.

# dependencies (use root-level patterns, but also catch this directory)
node_modules/
**/node_modules/
.pnp
.pnp.js

# testing
coverage/
**/coverage/

# production
build/
**/build/
dist/
**/dist/

# misc
.DS_Store
**/.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.secrets
**/.env.secrets

# TypeScript incremental build cache (composite-project emit + tsc -b buildinfo).
# Redirected into node_modules/.tsbuildcache/ via tsconfig tsBuildInfoFile/outDir,
# this pattern is a backstop in case any tool ever writes one at a default path.
*.tsbuildinfo

# AWS SAM build artifacts
.aws-sam/
**/.aws-sam/

# Playwright MCP debug artifacts (console logs, page snapshots/screenshots)
.playwright-mcp/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

.cursorignore
.vercel
**/.vercel

.vscode/
.idea/

# Documentation (optional - uncomment if you don't want to commit)
# PROJECT_PLAN.md
# DEVELOPMENT_RULES.md
# AWS_FREE_TIER_SETUP_GUIDE.md
docs/COOLIFY_PUBLIC_BACKEND_GUIDE.md
docs/DOCKER_VPS_BACKEND_PLAYBOOK.md
docs/HETZNER_VPS_MIGRATION_GUIDE.md
docs/SUBDOMAIN_ARNOBMAHMUD_SETUP.md
docs/personal-dev-info.txt
