# CodeBook backend — copy to .env for local dev, set the same keys in Coolify for production.
# Never commit the real .env file (already gitignored at repo root).

# Server — use 4000 locally so it does not collide with Vite on :3000
PORT=4000
NODE_ENV=development

# Postgres (Coolify shared container in production; local Postgres or Docker for dev)
DATABASE_URL=postgresql://codebook_user:CHANGE_ME@localhost:5432/codebook_db

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# JWT — generate a real value with `openssl rand -base64 64` (64+ random bytes,
# base64-encoded). Required in production: the server refuses to start if this
# is missing, under 32 chars, or still a known placeholder (see src/lib/auth.ts).
# This secret only ever lives on the backend — the frontend has no equivalent
# secret and never should (anything shipped to the browser bundle is public;
# it can hold the JWT it receives after login, but never the signing key).
JWT_SECRET=change-me-to-a-long-random-string

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Brevo (transactional email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=arnobt78@gmail.com
BREVO_SENDER_NAME=CodeBook Store
BREVO_ADMIN_EMAIL=arnobt78@gmail.com

# Shippo (shipping labels)
SHIPPO_API_KEY=
SHIPPO_FROM_NAME=CodeBook Store
SHIPPO_FROM_STREET1=123 Main St
SHIPPO_FROM_CITY=New York
SHIPPO_FROM_STATE=NY
SHIPPO_FROM_ZIP=10001
SHIPPO_FROM_COUNTRY=US
SHIPPO_FROM_PHONE=+1 555 123 4567
SHIPPO_FROM_EMAIL=arnobt78@gmail.com

# Google OAuth (REQ-1500-1505) — Client ID is public-safe, Client Secret is NOT.
# Never commit the real values. Set in Coolify env for production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# Where to send the browser after a successful Google sign-in (frontend Vite URL).
FRONTEND_URL=http://localhost:3000

# Optional override for QR code / product-link generation (src/lib/requestContext.ts).
# Falls back to the request's Origin header (or X-Forwarded-Host) when unset —
# only needed if that fallback chain doesn't resolve correctly behind your proxy.
BASE_URL=

# AI Business Insights (REQ-1613) — docs/LLM_MODEL_SELECTION.md
# Multi-provider fallback chain (backend/src/lib/ai/) — set as many as you have; only
# providers with a key configured are tried, in the priority order defined in
# backend/src/lib/ai/providers.ts. None are required — the feature degrades to a
# "not configured" state on the Business Insights page if all are empty.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GITHUB_AI_API_KEY=
HF_API_KEY=

# Sentry (error monitoring) — https://sentry.io. Browser events are tunneled
# through POST /api/monitoring (see routes/monitoring.routes.ts) instead of
# hitting *.ingest.sentry.io directly, so ad-blockers can't silently drop them.
# SENTRY_AUTH_TOKEN is build-time only (source map upload via
# @sentry/vite-plugin, wired in the frontend's vite.config.ts) — never expose
# it to the frontend bundle.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
