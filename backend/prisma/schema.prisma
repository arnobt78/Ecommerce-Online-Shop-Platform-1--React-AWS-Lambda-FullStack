// CodeBook E-Commerce — Prisma schema (PostgreSQL)
// Replaces the AWS DynamoDB tables 1:1 in domain shape so API response
// contracts stay identical to the AWS Lambda backend (REQ-1200, REQ-1202).
// Field names intentionally match the JSON keys the frontend already expects
// (snake_case where the Lambda backend used snake_case) to avoid a translation
// layer and reduce migration risk.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Parent: REQ-1202, REQ-1506. Extends the original codebook-users table with
// Google OAuth + avatar fields (REQ-1500-1507) not present in the AWS backend.
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String? // nullable: Google-only accounts have no password
  name                String?
  role                String    @default("user") // "user" | "admin" — unchanged from AWS backend
  image               String? // profile picture URL (Google) — REQ-1506
  googleId            String?   @unique // links a Google account — REQ-1506
  emailVerified       DateTime? // REQ-1506
  notificationsReadAt DateTime? // unchanged from AWS backend (shared/users.js)
  isDemo              Boolean   @default(false) // REQ-1510: marks seeded demo accounts eligible for the login page's one-click quick-login list
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  addresses           Address[] // REQ-1618: address book
  wishlist            Wishlist[] // REQ-1656
  refreshTokens       RefreshToken[] // REQ-1667

  @@index([role])
}

// Parent: REQ-1618. Customer address book — one row per saved address, with
// a single isDefault flag per user (enforced in the service layer, not a DB
// constraint, since Prisma has no partial-unique-index support here).
model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String? // e.g. "Home", "Work" — optional freeform tag
  fullName  String
  street1   String
  street2   String?
  city      String
  state     String
  zip       String
  country   String   @default("US")
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Parent: REQ-1202. Matches aws-lambda/shared/products.js item shape.
model Product {
  id                String   @id @default(uuid())
  name              String
  author            String? // REQ-1511: enriched catalog metadata
  category          String? // e.g. "Frontend Development", "Backend Development"
  level             String? // e.g. "Beginner", "Intermediate", "Advanced"
  pages             Int?
  price             Float
  overview          String?
  long_description  String?
  image_local       String?
  poster            String?
  in_stock          Boolean  @default(true)
  stock             Int?
  lowStockThreshold Int?
  best_seller       Boolean  @default(false)
  featured_product  Int      @default(0) // 1 = featured, 0 = not (kept as Int for parity with AWS GSI design; max 3 enforced in service layer)
  rating            Float?
  size              Int? // file size in MB (ebook download) — confirmed Int from data/db.json, not a clothing/apparel size
  qrCode            String?
  // REQ-1616: catalog/inventory metadata pass — digital-book-appropriate fields only
  // (no weight/dimensions/warehouse: the storefront's own FAQ confirms every title
  // is a pure digital download delivered via the Dashboard, never physically shipped).
  sku               String?  @unique // internal catalog/license code, e.g. "CB-FE-1001"
  isbn              String? // ISBN-13, still meaningful metadata for a digital edition
  publisher         String?
  publishedYear     Int?
  language          String?
  edition           String?
  fileFormat        String? // "PDF" | "EPUB" | "PDF + EPUB"
  tags              String[] @default([]) // genres/topics — used for related-products lookups
  // Cover art / trailer pass — enriches the flat product image with a stylized
  // "3D book" cover (spine + color, see src/components/ui/book-cover.tsx) and an
  // optional trailer video shown on the product detail page. Both nullable and
  // additive: products without them keep rendering the plain flat image exactly
  // as before, so this is a pure enrichment, not a breaking schema change.
  coverColor        String? // hex color for the BookCover spine/background, e.g. "#1e2a4b"
  videoUrl          String? // optional book-trailer video URL, rendered by ProductVideo
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  wishlistedBy      Wishlist[] // REQ-1656
  stockAlerts       StockAlert[] // REQ-1657

  @@index([featured_product])
}

// Parent: REQ-1202. Matches aws-lambda/shared/orders.js item shape.
// `user` is stored as a denormalized snapshot (id/name/email) exactly like the
// DynamoDB item did, so the API response shape doesn't change for the frontend.
model Order {
  id              String    @id @default(uuid())
  // REQ-1659: guest checkout orders get a synthetic "guest_<uuid>" id here
  // (never a real User.id) rather than making this column nullable — every
  // existing `order.userId !== req.user.id` ownership check across the
  // codebase keeps working unchanged (a guest order simply never matches any
  // authenticated user), so this stays purely additive.
  userId          String
  isGuest         Boolean   @default(false) // REQ-1659
  guestEmail      String? // REQ-1659: set only when isGuest — used by the no-auth guest order-lookup route
  user            Json // { id, name, email } snapshot at order time
  cartList        Json // array of cart line items
  amount_paid     Float
  quantity        Int
  status          String    @default("pending") // pending | processing | shipped | delivered | cancelled | refunded
  // REQ-1641: unique (nullable — Postgres allows multiple NULLs) so a
  // double-click or retried request after a network blip can never create
  // two DB orders for one Stripe payment; enforced at the DB level since an
  // app-level "check then insert" can't fully close the race on its own.
  paymentIntentId String? @unique
  paymentStatus   String?
  trackingNumber  String?
  trackingCarrier String?
  labelUrl        String?
  // REQ-1620: snapshot of the customer-selected saved Address at checkout time
  // (not a relation — orders must keep their own copy even if the address is
  // later edited/deleted). shipping.service.ts already reads this field name.
  shippingAddress Json?
  refundId        String?
  refundAmount    Int?
  refundedAt      DateTime?
  // REQ-1658: snapshot of the coupon applied at checkout (denormalized like
  // `user` above — a coupon can later be edited/deactivated without altering
  // the historical order record).
  couponCode      String?
  discountAmount  Int? // cents, matches refundAmount's unit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// Parent: REQ-1202. Matches aws-lambda/shared/activityLog.js item shape.
model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  userEmail  String?
  userName   String?
  action     String // create | update | delete | status_change
  entityType String // order | product | user
  entityId   String
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
}

// Parent: REQ-1202. Matches aws-lambda/shared/tickets.js item shape.
// `messages` is stored as a JSON array of {id, senderId, senderEmail, senderName, senderRole, message, createdAt}
// exactly like the DynamoDB item did.
model Ticket {
  id            String   @id @default(uuid())
  userId        String
  customerEmail String
  customerName  String   @default("Customer")
  subject       String
  status        String   @default("open") // open | in_progress | resolved | closed
  messages      Json     @default("[]")
  // REQ-1619: triage metadata
  priority      String   @default("medium") // low | medium | high | urgent
  category      String   @default("other") // billing | technical | refund | account | other
  orderId       String? // optional: which order this ticket concerns (e.g. a refund request)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// Parent: REQ-1202. Matches aws-lambda/shared/reviews.js item shape.
model Review {
  id           String    @id @default(uuid())
  productId    String
  userId       String
  orderId      String
  rating       Int
  comment      String
  userName     String    @default("Customer")
  userEmail    String    @default("")
  status       String    @default("approved") // approved | pending | rejected
  // REQ-1619: public seller response to a review
  adminReply   String?
  adminReplyAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([productId])
  @@index([userId])
}

// Parent: REQ-1656 — save-for-later. Unique pair prevents duplicate saves;
// no `onDelete` cascade complications since both parents (User/Product) are
// hard-deleted rarely and this is a pure convenience join table.
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// Parent: REQ-1657 — "Notify me" subscription for an out-of-stock product.
// `email` (not just userId) so the same mechanism could later support a
// non-authenticated notify-me form without a schema change; `notifiedAt` marks
// a row as fulfilled instead of deleting it, giving a lightweight send history.
model StockAlert {
  id         String    @id @default(uuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  email      String
  userId     String? // set when the subscriber was logged in; null for a bare-email subscription
  notifiedAt DateTime? // null = still pending; set once the restock email has been sent
  createdAt  DateTime  @default(now())

  @@unique([productId, email])
  @@index([productId])
}

// Parent: REQ-1658 — checkout discount codes. `type`/`value` pair mirrors the
// two common real-world discount shapes (percent-off, fixed-amount-off)
// without needing a polymorphic table. Usage is enforced server-side only
// (see coupons.service.ts) — never trust a client-computed discount amount.
model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  type           String // "percent" | "fixed"
  value          Float // percent: 0-100, fixed: dollars
  minOrderAmount Float? // dollars; order subtotal must meet this to apply
  maxUses        Int? // null = unlimited
  timesUsed      Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Parent: REQ-1663 — customer-initiated post-delivery return request, with
// admin approve/reject. Approval reuses the existing refundOrderPayment()
// Stripe flow from REQ-1639 rather than a parallel refund path.
model ReturnRequest {
  id           String    @id @default(uuid())
  orderId      String
  userId       String
  reason       String
  status       String    @default("requested") // requested | approved | rejected | refunded
  adminNote    String?
  refundId     String?
  refundAmount Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orderId])
  @@index([userId])
}

// Parent: REQ-1667 — enables a short-lived access token (see lib/auth.ts)
// without forcing a re-login every few minutes. Only a hash of the token is
// stored (never the raw value) so a DB leak alone can't be replayed; rotated
// (old row revoked, new row issued) on every use to detect theft — a reused
// revoked token signals the refresh chain was compromised.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
